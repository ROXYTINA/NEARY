  "reviews": [
    {"id":"r1","salonId":"s1","userName":"Sopheara Mey","userAvatar":"https://i.pravatar.cc/150?img=1","rating":5.0,"comment":"Absolutely stunning work! Sophie did my balayage and it came out exactly as I envisioned. The salon is gorgeous too — very luxurious.","date":"2025-04-12","photos":["https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?w=400"],"service":"French Balayage"},
    {"id":"r2","salonId":"s1","userName":"Chanthy Ros","userAvatar":"https://i.pravatar.cc/150?img=2","rating":5.0,"comment":"Marie is a wizard. My bridal look was perfection — I cried happy tears seeing myself. Worth every penny.","date":"2025-03-28","photos":["https://images.unsplash.com/photo-1519741347686-c1e0aadf4611?w=400"],"service":"Bridal Makeup"},
    {"id":"r3","salonId":"s1","userName":"Lina Keo","userAvatar":"https://i.pravatar.cc/150?img=3","rating":4.8,"comment":"Amazing precision cut. Really listened to what I wanted and delivered. Will definitely be back.","date":"2025-02-15","photos":[],"service":"Precision Haircut & Style"},
    {"id":"r4","salonId":"s2","userName":"Dara Phon","userAvatar":"https://i.pravatar.cc/150?img=4","rating":4.7,"comment":"Mia's nail art is incredible! Got the floral 3D design and everyone keeps complimenting me. Great price too.","date":"2025-04-05","photos":["https://images.unsplash.com/photo-1604654894610-df63bc536371?w=400"],"service":"Gel Manicure"},
    {"id":"r5","salonId":"s2","userName":"Bopha Suon","userAvatar":"https://i.pravatar.cc/150?img=5","rating":4.9,"comment":"The pedicure experience is heavenly. The foot soak smells amazing and the massage is divine. My go-to for relaxation.","date":"2025-01-20","photos":[],"service":"Luxury Pedicure"},
    {"id":"r6","salonId":"s3","userName":"Sokha Im","userAvatar":"https://i.pravatar.cc/150?img=6","rating":5.0,"comment":"Isabelle made me look like a celebrity. The products she uses are top-tier. I felt so confident at my event.","date":"2025-04-18","photos":[],"service":"Full Glam Makeup"},
    {"id":"r7","salonId":"s3","userName":"Sreyleak Uy","userAvatar":"https://i.pravatar.cc/150?img=7","rating":5.0,"comment":"The gold bridal package is WORTH IT. Every single service was flawless. The team is incredibly professional.","date":"2025-03-10","photos":["https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=400"],"service":"Bridal Package Gold"},
    {"id":"r8","salonId":"s4","userName":"Kimly Heng","userAvatar":"https://i.pravatar.cc/150?img=8","rating":4.8,"comment":"The hot stone massage was life-changing. I walked out floating. Nara is so skilled and attentive.","date":"2025-04-01","photos":[],"service":"Hot Stone Massage"},
    {"id":"r9","salonId":"s5","userName":"Ratana Sim","userAvatar":"https://i.pravatar.cc/150?img=9","rating":4.6,"comment":"Keratin treatment completely transformed my hair. Alex was thorough with the aftercare instructions too.","date":"2025-02-28","photos":["https://images.unsplash.com/photo-1470259078422-826894b933aa?w=400"],"service":"Keratin Treatment"},
    {"id":"r10","salonId":"s7","userName":"Panha Chum","userAvatar":"https://i.pravatar.cc/150?img=10","rating":5.0,"comment":"Pisey's Khmer traditional massage is something else. Deep pressure, herbal compresses — I've never been so relaxed in my life.","date":"2025-04-20","photos":[],"service":"Khmer Traditional Massage"},
    {"id":"r11","salonId":"s8","userName":"Sreynich Mao","userAvatar":"https://i.pravatar.cc/150?img=11","rating":4.9,"comment":"Leila's minimalist nail art is stunning. She's a true artist. The studio is so cute and hygiene is impeccable.","date":"2025-03-15","photos":["https://images.unsplash.com/photo-1604654894610-df63bc536371?w=400"],"service":"Minimalist Nail Art"},
    {"id":"r12","salonId":"s9","userName":"Monika Kang","userAvatar":"https://i.pravatar.cc/150?img=12","rating":5.0,"comment":"Charlotte is the best bridal artist in Phnom Penh, full stop. Every bride I know recommends her. Booked 6 months in advance!","date":"2025-04-08","photos":["https://images.unsplash.com/photo-1519741347686-c1e0aadf4611?w=400"],"service":"Bridal Full Package Platinum"},
    {"id":"r13","salonId":"s10","userName":"Virak Ny","userAvatar":"https://i.pravatar.cc/150?img=13","rating":4.7,"comment":"Couples massage with my partner — such a romantic experience. Nora and Tom were both wonderful. Highly recommend for anniversaries!","date":"2025-02-14","photos":[],"service":"Couples Massage"},
    {"id":"r14","salonId":"s1","userName":"Pich Sothea","userAvatar":"https://i.pravatar.cc/150?img=14","rating":4.9,"comment":"The salon itself is absolutely gorgeous. I love the French aesthetic. My blowout lasted 4 days!","date":"2024-12-05","photos":[],"service":"Precision Haircut & Style"},
    {"id":"r15","salonId":"s1","userName":"Davann Hor","userAvatar":"https://i.pravatar.cc/150?img=15","rating":4.7,"comment":"Lucas did my highlights and the color is perfect. So natural looking. Will come back for balayage next time.","date":"2025-01-08","photos":["https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?w=400"],"service":"Highlights & Toning"},
    {"id":"r16","salonId":"s2","userName":"Leakhena Om","userAvatar":"https://i.pravatar.cc/150?img=16","rating":4.8,"comment":"The aromatherapy massage was incredible. Lily customized the oil blend for my stress relief. Will be a monthly ritual now.","date":"2025-03-22","photos":[],"service":"Aromatherapy Massage"},
    {"id":"r17","salonId":"s3","userName":"Chanpagna Lim","userAvatar":"https://i.pravatar.cc/150?img=17","rating":4.7,"comment":"Deep cleansing facial was a game changer for my skin. Emma was so gentle and knowledgeable. Skin has been glowing ever since!","date":"2025-04-11","photos":[],"service":"Deep Cleansing Facial"},
    {"id":"r18","salonId":"s4","userName":"Sreymom Yim","userAvatar":"https://i.pravatar.cc/150?img=18","rating":4.8,"comment":"Srey Pov's 3D nail art is insane! I got the cherry blossom design and had strangers stopping me to ask where I got them done.","date":"2025-04-02","photos":["https://images.unsplash.com/photo-1604654894610-df63bc536371?w=400"],"service":"Nail Art (3D Design)"},
    {"id":"r19","salonId":"s6","userName":"Chakriya Rath","userAvatar":"https://i.pravatar.cc/150?img=19","rating":4.6,"comment":"Got lash extensions from Jane and I wake up looking fabulous every day. The fill-ins are easy and affordable too.","date":"2025-04-16","photos":[],"service":"Lash Extensions (Classic)"},
    {"id":"r20","salonId":"s11","userName":"Sokleang Pen","userAvatar":"https://i.pravatar.cc/150?img=20","rating":4.5,"comment":"Zara transformed my look completely — went from boring brown to a vivid rose gold. I've never felt so ME. She's so creative.","date":"2025-03-30","photos":["https://images.unsplash.com/photo-1470259078422-826894b933aa?w=400"],"service":"Bold Color Transformation"},
    {"id":"r21","salonId":"s12","userName":"Lyda Chea","userAvatar":"https://i.pravatar.cc/150?img=21","rating":5.0,"comment":"Ivory & Rose is simply the best. Every visit feels like being at a 5-star spa. The level of care and attention is unmatched.","date":"2025-04-14","photos":[],"service":"Signature Bridal Hair"}
